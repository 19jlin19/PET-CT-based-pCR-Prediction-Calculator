{
  "app_name": "PET/CT-based pCR Prediction Calculator",
  "model_name": "Random Forest",
  "outcome": "Pathological complete response (pCR)",
  "positive_class": "pCR",
  "features": [
    "SUV_ratio",
    "SUVmax2",
    "SUVmax1",
    "Smoking",
    "RECIST_response",
    "Histological",
    "cN"
  ],
  "continuous_features": [
    "SUVmax1",
    "SUVmax2",
    "SUV_ratio"
  ],
  "categorical_features": {
    "Smoking": {
      "0": "No",
      "1": "Yes"
    },
    "RECIST_response": {
      "Responder": "CR/PR",
      "Non-responder": "SD/PD"
    },
    "Histological": {
      "LUAD": "Lung adenocarcinoma",
      "LUSC": "Lung squamous cell carcinoma"
    },
    "cN": {
      "cN0-1": "cN0-1",
      "cN2": "cN2"
    }
  },
  "suv_ratio_formula": "(SUVmax1 - SUVmax2) / SUVmax1",
  "threshold": 0.426077,
  "validation_method": "Training-only repeated nested stratified five-fold cross-validation repeated five times; validation cohort reserved for final evaluation.",
  "performance": {
    "training_auc": 0.948,
    "nested_cv_auc": 0.823,
    "nested_cv_auc_ci95": [
      0.802,
      0.844
    ],
    "nested_cv_brier": 0.167,
    "validation_auc": 0.874,
    "validation_auc_ci95": [
      0.768,
      0.958
    ],
    "validation_accuracy": 0.824,
    "validation_sensitivity": 0.667,
    "validation_specificity": 0.909,
    "validation_brier_score": 0.141,
    "supplementary_bootstrap_oob_aggregated_auc": 0.83,
    "supplementary_bootstrap_oob_mean_auc": 0.828
  },
  "cohort": {
    "training_n": 203,
    "validation_n": 51
  },
  "intended_use": "Research use only. Not for standalone clinical decision-making.",
  "version": "2.0.0-nestedCV"
}
